# Debian buster ships gcc 8.3 + glibc 2.28: the same pair as Onion's official toolchain
# (OnionUI/dev-miyoomini-toolchain = debian/eol:buster + ARM GNU 8.3-2019.03, glibc 2.28), so the
# dynamically linked pager runs against the Miyoo's own /lib/libc.so.6 and Onion's libpadsp.so
# LD_PRELOAD can route /dev/dsp to audioserver. A newer glibc (Ubuntu 24.04 = 2.39) would not load.
FROM docker.io/debian/eol:buster-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc-arm-linux-gnueabihf libc6-dev-armhf-cross binutils-arm-linux-gnueabihf make qemu-user \
 && rm -rf /var/lib/apt/lists/*
