# Copy to pager.cfg next to the pager binary.
# One line per computer running bridge/pager-bridge.mjs (max 4):
#   bridge = <ip>:<port> <token from ~/.config/paseo-pager/token on that computer>
# IP addresses only (no hostnames).
bridge = 192.168.1.233:6780 PASTE_TOKEN_HERE
# bridge = 192.168.1.68:6780 PASTE_BAZZITE_TOKEN_HERE

pet_name = Tok
# Buzz on new alerts (1/0)
rumble = 1
# Chiptune cues, 0 (off) to 10. Cues are short and rate-limited.
volume = 4
# No sound 23:00-07:00 (bridge's local time) (1/0)
quiet_nights = 1
# Turn the screen off after this many idle seconds (0 = never). Any button or a new alert wakes it.
screen_timeout = 120
# Keep the screen on while plugged in (1/0)
awake_on_power = 1
# Backlight level 0-10 (Onion's scale) from 01:00 to 06:00 (bridge's local time) while plugged in;
# 0 is the lowest lit setting. Your own level comes back in the morning. -1 = never dim.
night_dim = 0
# Mini Plus: charge the battery to 4.1 V instead of 4.2 V, which is kinder to a battery that lives
# on the charger (1/0). 0 puts back 4.2 V.
battery_care = 1
